with "aunit";
with "config/tests_config.gpr";

project Tests is

   for Source_Dirs use ("src", "src/base", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnata",           --  Pre/Post checked at runtime
         "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O2", "-fstack-check");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
